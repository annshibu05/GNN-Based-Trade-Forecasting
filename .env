# Database Configuration
DATABASE_URL=postgresql://postgres:gnn-trade@localhost:5432/trade_forecasting
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:gnn-trade@localhost:5432/trade_forecasting

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Google Cloud (for BigQuery GDELT access)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
GCP_PROJECT_ID=trade-forecasting-gdelt

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Model Configuration
MODEL_PATH=models/saved_models
MODEL_VERSION=v1.0
DEVICE=cuda  # or cpu

# DEVICE=cpu

# Data Paths
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
GDELT_CACHE_PATH=data/live/gdelt_latest

# Training Configuration
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=200
EARLY_STOPPING_PATIENCE=20
VAL_SPLIT=0.15
TEST_SPLIT=0.15

# GDELT Fetcher Configuration
GDELT_FETCH_INTERVAL_MINUTES=15
GDELT_LOOKBACK_DAYS=7
GDELT_MIN_TONE=-10
GDELT_MAX_TONE=10

# Alert Thresholds
ALERT_SENTIMENT_THRESHOLD=2.0
ALERT_PREDICTION_DROP_THRESHOLD=0.15
ALERT_PREDICTION_SPIKE_THRESHOLD=0.20

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security (for production)
SECRET_KEY=e69595a90a4bd3c087196297a879affb1c0dd7da90f8efab4c244f69231d0dad
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30